@model PharmacyJobPlatform.Web.Models.Support.SupportMessageCreateViewModel

@{
    ViewData["Title"] = "Destek";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h2 class="fw-bold mb-2"><i class="bi bi-life-preserver me-2"></i>Destek Merkezi</h2>
                <p class="text-muted mb-4">
                    Site ile ilgili yaşadığınız sorunları bu form üzerinden admin ekibine iletebilirsiniz.
                </p>

                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">@successMessage</div>
                }

                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <form asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label"></label>
                        <input asp-for="Subject" class="form-control" placeholder="Örn: Giriş yapamıyorum" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content"
                                  class="form-control"
                                  rows="7"
                                  placeholder="Sorununuzu adım adım yazarak bize iletebilirsiniz..."></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-send me-2"></i>Mesajı Gönder
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
